# DevOS backend
DEVOS_DATABASE_URL=postgresql+psycopg://devos:devos@localhost:5432/devos

# Optional. With a key, an AI writes the one-line explanation for each step of a plan (the steps themselves
# always come from fixed rules, and the AI never sees values, passwords or logs). Without a key, or if the
# call fails, the built-in wording is used.
DEVOS_LLM_API_KEY=
# anthropic | gemini
DEVOS_LLM_PROVIDER=anthropic
# Empty = the provider's default (anthropic: claude-opus-5, gemini: gemini-2.5-flash)
DEVOS_LLM_MODEL=
